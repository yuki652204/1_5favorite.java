/.metadata/

# Maven
target/
*.jar
*.war
*.ear
# .m2フォルダ（ライブラリ）はリポジトリに含めない
.m2/
repository/

# IDE (Eclipse/STS)
.settings/
.classpath
.project
.factorypath

# IDE (IntelliJ/VSCode)
